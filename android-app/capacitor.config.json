{
  "appId": "com.studsup.game",
  "appName": "Studs Up",
  "webDir": "www",
  "backgroundColor": "#000000",
  "server": {
    "androidScheme": "https"
  },
  "android": {
    "backgroundColor": "#000000"
  },
  "plugins": {
    "SystemBars": {
      "hidden": true,
      "style": "DARK",
      "initialViewportFitValueHint": "cover"
    }
  },
  "ios": {
    "includePlugins": [
      "@capacitor-community/admob",
      "@capacitor-community/in-app-review",
      "@capacitor/filesystem",
      "@capacitor/haptics",
      "@capacitor/share",
      "cordova-plugin-purchase"
    ]
  }
}
